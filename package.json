{
  "name": "jane",
  "version": "0.7.0",
  "private": true,
  "description": "Jane: an adaptive learning app for kids, built on the Marble Skill Taxonomy. Runs on Cloudflare Workers or as a standalone Node server.",
  "type": "module",
  "license": "SEE LICENSING.md",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node build.mjs && node server/index.mjs",
    "serve": "node server/index.mjs",
    "build": "node build.mjs",
    "research": "node research.mjs",
    "dev": "node build.mjs && wrangler dev",
    "test": "node --test test/*.test.mjs",
    "deploy": "./deploy.sh",
    "deploy:dry": "./deploy.sh --dry-run --outdir .wrangler/dist",
    "export": "node export-progress.mjs",
    "export:local": "node export-progress.mjs --local",
    "publish:dry": "node publish-lessons.mjs packs/examples/example-quest.json --dry-run --offline",
    "backup": "node backup-progress.mjs",
    "backup:local": "node backup-progress.mjs --local"
  },
  "devDependencies": {
    "@floating-ui/dom": "1.8.0",
    "@formkit/auto-animate": "0.10.0",
    "canvas-confetti": "1.9.4",
    "esbuild": "0.28.2",
    "motion": "14.3.0",
    "wrangler": "4.151.1"
  }
}
